<Page x:Class="WinIsland.IslandPages.MusPlayer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:controls="clr-namespace:WinIsland.Controls"
      xmlns:local="clr-namespace:WinIsland"
      mc:Ignorable="d" 
      d:DesignHeight="370" d:DesignWidth="872"
      Title="MusPlayer">

    <Grid>
        <Grid.Resources>
            <Style x:Name="buttonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource ButtonBaseBrush}"/>
                <Setter Property="Effect" Value="{DynamicResource ButtonEffect}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border RenderTransformOrigin="0.5,0.5" x:Name="ButtonGrid" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonCornerRadius}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="{DynamicResource ButtonBorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="ButtonGrid" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="0.85">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BounceEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="ButtonGrid" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="0.85">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.05" Storyboard.TargetName="ButtonGrid" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Duration="0:0:0.05" Storyboard.TargetName="ButtonGrid" Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonPressBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="Gray"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <StackPanel Orientation="Horizontal">
            <Grid x:Name="thumbnailGlow" MaxWidth="200" MaxHeight="200" Margin="50,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="floatAnim"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Rectangle Visibility="{DynamicResource ThumbnailGlowVisibility}">
                    <Rectangle.Effect>
                        <BlurEffect Radius="20" KernelType="Gaussian" RenderingBias="Performance"/>
                    </Rectangle.Effect>
                    <Rectangle.Fill>
                        <VisualBrush Visual="{Binding ElementName=songThumbnail}" Stretch="None"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Image x:Name="songThumbnail" Stretch="Uniform" Width="200" Height="200">
                    <Image.Resources>
                        <Style x:Name="imgStyle" TargetType="{x:Type Image}">
                            <Setter Property="Effect" Value="{DynamicResource ImageEffect}"/>
                        </Style>
                    </Image.Resources>
                </Image>
            </Grid>
            <StackPanel Margin="30,65,0,0" Orientation="Vertical" VerticalAlignment="Stretch">
                <controls:TextMarquee x:Name="songTitle" Text="No song playing" FontSize="24" Width="450" Height="32" FontFamily="Segoe UI" FontWeight="Bold" ScrollSpeed="35" PauseDuration="1.5" Foreground="{DynamicResource ForegroundTextBrush}"/>
                <controls:TextMarquee x:Name="songArtist"
                      Text="WinIsland by Charamellized"
                      Width="{DynamicResource SongTitleWidth}"
                      Height="{DynamicResource SongTitleHeight}"
                      Foreground="{DynamicResource SecondaryTextBrush}"
                      FontSize="{DynamicResource SongArtistFontSize}"/>

                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,0" Orientation="Vertical">
                    <Slider x:Name="songProgress" ValueChanged="songProgress_ValueChanged" HorizontalAlignment="Stretch"/>
                    <Label x:Name="songProgressLabel" Content="curVal/maxVal" HorizontalAlignment="Center" FontFamily="Segoe UI" FontWeight="Light" Foreground="{DynamicResource ForegroundTextBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" Orientation="Horizontal">
                    <Button x:Name="beforeRewind" Click="beforeRewind_Click" Content="&#xE100;" Height="50" Width="50" Margin="0,0,10,0" FontFamily="../Fonts/#Segoe Fluent Icons" FontSize="24" BorderThickness="0" FontWeight="Bold"/>
                    <Button x:Name="playPause" Click="playPause_Click" Content="&#xE102;" Height="50" Width="50" Margin="0,0,10,0" FontFamily="../Fonts/#Segoe Fluent Icons" FontSize="24" BorderThickness="0" FontWeight="Bold"/>
                    <Button x:Name="afterForward" Click="afterForward_Click" Content="&#xE101;" Height="50" Width="50" FontFamily="../Fonts/#Segoe Fluent Icons" FontSize="24" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
