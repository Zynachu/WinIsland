<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!-- You can also overwrite iNKORE.UI themes, which basically grants you app-wide theme control -->
    
    <!-- Light mode variant -->

    <!-- Border colors (lighter for light mode) -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="MainBorderBrush" Color="#CCCCCC"/>
    
    <!-- Island Colors -->
    <SolidColorBrush x:Key="IslandBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ForegroundTextBrush" Color="Black"/>

    <!-- Button colors -->
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="ButtonPressBrush" Color="#11000000"/>
    <SolidColorBrush x:Key="ButtonBaseBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#444444"/>
    <Thickness x:Key="ButtonBorderThickness">0</Thickness>
    
    <!-- Page Elements -->
    <Visibility x:Key="AlbumBackgroundImageVisibility">Visible</Visibility>
    <!-- Disabling this also disables the background -->
    <Visibility x:Key="AlbumBackgroundGradientVisibility">Visible</Visibility>
    <Visibility x:Key="ThumbnailGlowVisibility">Visible</Visibility>

    <!-- UI Effects -->
    <!-- Ex: <DropShadowEffect x:Key="ButtonEffect" BlurRadius="10" ShadowDepth="2" Color="Black"/> -->
    <x:Null x:Key="ButtonEffect"/>
    <x:Null x:Key="ImageEffect"/>
    
    <!-- Text colors -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>

    <!-- Opacity values (less pronounced in light mode) -->
    <System:Double x:Key="BackgroundImageOpacity">0.15</System:Double>
    <System:Double x:Key="GradientOpacity">0.4</System:Double>

    <!-- Corner radius -->
    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">5</CornerRadius>

    <!-- Margins and spacing -->
    <Thickness x:Key="WindowMargin">20,5,20,29</Thickness>
    <Thickness x:Key="WindowBorderThickness">1,1,1,1</Thickness>
    <Thickness x:Key="ClockMargin">15,6,0,0</Thickness>
    <Thickness x:Key="BatteryMargin">0,6,15,0</Thickness>
    <Thickness x:Key="IslandMiniMargin">0,0,60,0</Thickness>
    <Thickness x:Key="ThumbnailGlowMargin">50,0,0,0</Thickness>
    <Thickness x:Key="SongInfoMargin">30,65,0,0</Thickness>
    <Thickness x:Key="ControlsMargin">0,50,0,0</Thickness>

    <!-- Font sizes -->
    <System:Double x:Key="ClockFontSize">16</System:Double>
    <System:Double x:Key="BatteryFontSize">64</System:Double>
    <System:Double x:Key="MiniControlFontSize">15</System:Double>
    <System:Double x:Key="SongTitleFontSize">24</System:Double>
    <System:Double x:Key="SongArtistFontSize">16</System:Double>

    <!-- Dimensions -->
    <System:Double x:Key="MiniControlSize">25</System:Double>
    <System:Double x:Key="MiniControlSpacing">5</System:Double>
    <System:Double x:Key="ThumbnailSize">200</System:Double>
    <System:Double x:Key="SongTitleWidth">450</System:Double>
    <System:Double x:Key="SongTitleHeight">32</System:Double>

    <!-- Animation values -->
    <System:Double x:Key="ButtonPressScale">0.85</System:Double>
    <System:Double x:Key="ButtonNormalScale">1.0</System:Double>
    <Duration x:Key="ButtonPressDuration">0:0:0.1</Duration>
    <Duration x:Key="ButtonReleaseDuration">0:0:0.05</Duration>

    <!-- Text marquee -->
    <System:Double x:Key="MarqueeScrollSpeed">35</System:Double>
    <System:Double x:Key="MarqueePauseDuration">1.5</System:Double>

    <!-- Blur effects -->
    <System:Double x:Key="ThumbnailBlurRadius">20</System:Double>
    
    

</ResourceDictionary>
